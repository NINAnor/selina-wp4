{% extends "base.html.jinja" %}

{% block content %}
    <div id="survey" class="mt-5 px-4"></div>
{% endblock %}

{% block head %}
<link href="https://unpkg.com/survey-core/survey-core.min.css" type="text/css" rel="stylesheet">
<script type="text/javascript" src="https://unpkg.com/survey-core/survey.core.min.js"></script>
<script type="text/javascript" src="https://unpkg.com/survey-js-ui/survey-js-ui.min.js"></script>
{% endblock %}

{% block scripts %}
<script src="https://unpkg.com/dompurify@3.2.4/dist/purify.min.js"></script>
<script src="https://unpkg.com/marked@15.0.7/marked.min.js"></script>

<script>
    window.config = {{ config|tojson|safe }};
    window.isDevMode = {{ (MODE == 'dev')|tojson }};
</script>
<script src="/static/survey-theme.js"></script>
<script src="/static/app.js"></script>
{% endblock %}
