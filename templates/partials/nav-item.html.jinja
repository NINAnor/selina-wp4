{% if item.children %}
{% if depth > 0 %}
<details>
    <summary class="text-lg {% if item.highlight %}text-accent{% else %}text-primary{% endif %}">{{ item.name }}</summary>
    <ul>
        {% for i in item.children %}
        {% with item = i, depth=depth+1 %}
        {% include 'partials/nav-item.html.jinja' %}
        {% endwith %}
        {% endfor %}
    </ul>
</details>
{% else %}
<li class="dropdown">
  <button tabindex="0" class="text-lg {% if item.highlight %}text-accent{% else %}text-primary{% endif %}">
    {{ item.name }}
    <svg class="w-4 h-4" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M201.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 338.7 54.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>
  </button>
  <ul tabindex="-1" class="dropdown-content menu bg-accent text-accent-content rounded-box z-1 min-w-56 max-w-[calc(100vw-2rem)] p-2 shadow-sm">
    {% for i in item.children %}
    {% with item = i, depth=depth+1 %}
    {% include 'partials/nav-item.html.jinja' %}
    {% endwith %}
    {% endfor %}
  </ul>
</li>
{% endif %}
{% else %}
<li class="text-lg hover:bg-accent {% if item.highlight %}text-accent{% else %}text-primary{% endif %}"><a href="{{item.link}}">{{ item.name }}</a></li>
{% endif %}
