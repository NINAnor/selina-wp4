{% extends "base.html.jinja" %}

{% block head %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/solid.min.css">
{% endblock %}

{% block content %}
<section id="hero" class="pt-5">
    <div class="flex justify-center items-center h-full">
        <div class="py-8 px-4 mx-auto max-w-screen-xl text-center lg:py-16 lg:px-12">
            <h1 class="mb-4 text-4xl font-extrabold tracking-tight leading-none text-primary-content md:text-5xl">{{CONFIG.home.title}}</h1>
            <p class="mb-8 text-lg font-normal text-primary-content lg:text-3xl sm:px-16 xl:px-48 ">{{ CONFIG.home.subtitle}}</p>
            <div class="flex flex-col mb-8 lg:mb-16 space-y-4 sm:flex-row sm:justify-center sm:space-y-0 sm:space-x-4">
                <a href="{{ CONFIG.home.cta_url }}" class="inline-flex justify-center items-center py-3 px-5 text-base font-medium text-center text-accent-content rounded-lg bg-accent hover:bg-accent focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-900">
                    {{ CONFIG.home.cta_text }}
                </a>
            </div>
        </div>
    </div>
</section>

<section id="who-is-this-for" class="py-16 bg-base-100">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-12 text-center">
        <h2 class="text-3xl font-bold mb-12">{{ CONFIG.who_is_this_for.title }}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {% for card in CONFIG.who_is_this_for.cards %}
            <div class="card bg-base-200 shadow-sm">
                <div class="card-body items-center text-center">
                    <i class="{{ card.icon }} fa-3x text-primary mb-4"></i>
                    <h3 class="card-title">{{ card.heading }}</h3>
                    <p>{{ card.description }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
        <p class="mt-12 text-xl font-semibold">{{ CONFIG.who_is_this_for.closing }}</p>
        <a href="{{ CONFIG.home.cta_url }}" class="btn btn-accent mt-4">{{ CONFIG.home.cta_text }}</a>
    </div>
</section>

{% endblock %}
